{
  "name": "01-user-service",
  "about": "Service users dibangun dari folder kosong (Go net/http, in-memory) lewat percakapan nyata dengan tool call: Write/Edit kode, go build, curl. Keputusan berubah (/users/abc 400 jadi 404, PATCH replace jadi partial, soft delete jadi hard delete), saran assistant ditolak (GET /users list, JWT, target 100 ms), noise project lain sebelum /qa-start. Bug yang ditanam = regresi dari 3 bug yang sudah diperbaiki di percakapan.",
  "scope": "api medium",
  "expect": [
    {"id": "E1", "all": ["\\b200\\b"], "type": "stated", "testable": "api",
     "output": [{"method": "GET", "path": "/users/1", "expect_status": 200, "expect_jq": ".id == 1 and .email == \"exists@test.co\""}]},
    {"id": "E2", "all": ["404"], "type": "stated", "testable": "api",
     "output": [{"method": "GET", "path": "/users/999999", "expect_status": 404}]},
    {"id": "E3", "all": ["abc|bukan angka", "404"], "type": "stated", "testable": "api",
     "output": [{"method": "GET", "path": "/users/abc", "expect_status": 404}]},
    {"id": "E4", "all": ["email", "format|valid"], "type": "stated", "testable": "api",
     "output": [{"method": "POST", "path": "/users", "body": {"email": "bukan-email", "name": "A"}, "expect_status": 400, "match": "\"email\": \"([^\"@]*|[^\"]*@[^\".]*)\""}]},
    {"id": "E5", "all": ["name|nama", "wajib|kosong|spasi"], "type": "stated", "testable": "api",
     "output": [{"method": "POST", "path": "/users", "body": {"email": "spasi@test.co", "name": "   "}, "expect_status": 400, "match": "\"name\": \"\\s*\""}]},
    {"id": "E6", "all": ["409|unik|duplikat"], "type": "stated", "testable": "api",
     "output": [{"method": "POST", "path": "/users", "body": {"email": "exists@test.co", "name": "X"}, "expect_status": 409}]},
    {"id": "E7", "all": ["huruf|case|besar|EXISTS"], "type": "stated", "testable": "api",
     "output": [{"method": "POST", "path": "/users", "body": {"email": "EXISTS@test.co", "name": "X"}, "expect_status": 409, "match": "\"email\": \"[^\"]*[A-Z]"}]},
    {"id": "E8", "all": ["201"], "type": "stated", "testable": "api",
     "output": [{"method": "POST", "path": "/users", "body": {"email": "baru@test.co", "name": "Baru"}, "expect_status": 201, "expect_jq": ".id > 1 and .email == \"baru@test.co\""}]},
    {"id": "E9", "all": ["PATCH|update|ubah|edit", "sebagian|tidak dikirim|tidak boleh berubah|partial"], "type": "stated", "testable": "api",
     "output": [{"method": "PATCH", "path": "/users/1", "body": {"name": "Baru"}, "expect_status": 200, "expect_jq": ".name == \"Baru\" and .email == \"exists@test.co\"", "match": "^[^|]*\"name\"(?![^|]*\"email\")"}]},
    {"id": "E10", "all": ["DELETE|hapus", "204"], "type": "stated", "testable": "api",
     "output": [{"method": "POST", "path": "/users", "body": {"email": "hapus@test.co", "name": "H"}, "expect_status": 201, "save": {"ID": ".id"}},
                {"method": "DELETE", "path": "/users/$ID", "expect_status": 204}]},
    {"id": "E11", "all": ["dihapus|setelah|hard", "404"], "type": "stated", "testable": "api",
     "output": [{"method": "POST", "path": "/users", "body": {"email": "hapus@test.co", "name": "H"}, "expect_status": 201, "save": {"ID": ".id"}},
                {"method": "DELETE", "path": "/users/$ID", "expect_status": 204},
                {"method": "GET", "path": "/users/$ID", "expect_status": 404}]},
    {"id": "E12", "all": ["error"], "type": "stated", "testable": "api",
     "output": [{"method": "GET", "path": "/users/999999", "expect_status": 404, "expect_jq": ".error | type == \"string\"", "match": "\\| .*\\.error"}]},
    {"id": "E13", "all": ["disable|tombol"], "type": "stated", "testable": "ui"}
  ],
  "forbid": ["legacy", "\\b410\\b", "sales@|Vercel|company profile"],
  "bugs": [
    {"id": "dup-email-case", "patch": "bugs/dup-email-case.patch", "when": {"method": "POST", "path": "^/users$", "expect_status": 409},
     "probe": [{"method": "POST", "path": "/users", "body": {"email": "EXISTS@test.co", "name": "X"}, "expect_status": 409}]},
    {"id": "patch-nulls", "patch": "bugs/patch-nulls.patch", "when": [{"method": "PATCH", "path": "^/users/\\d+$"}, {"method": "GET", "path": "^/users/\\d+$", "expect_status": 200}],
     "probe": [{"method": "PATCH", "path": "/users/1", "body": {"name": "Baru"}, "expect_status": 200, "expect_jq": ".email == \"exists@test.co\""}]},
    {"id": "delete-soft", "patch": "bugs/delete-soft.patch", "when": [{"method": "GET", "path": "^/users/\\d+$", "expect_status": 404}, {"method": "DELETE", "path": "^/users/\\d+$", "expect_status": 404}, {"method": "PATCH", "path": "^/users/\\d+$", "expect_status": 404}],
     "probe": [{"method": "DELETE", "path": "/users/1", "expect_status": 204},
               {"method": "GET", "path": "/users/1", "expect_status": 404}]}
  ]
}
